rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isFollowing(targetUserId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(targetUserId)).data.followers.hasAny([request.auth.uid]);
    }
    
    function isPublicProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isPrivate == false;
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    
    match /users/{userId} {
      // Anyone can read public profiles (for social features)
      allow read: if true;
      
      // Only the user can create their own profile with validation
      allow create: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30;
      
      // Only the user can update their own profile
      // Allow updating followers/following arrays by authenticated users (for follow/unfollow)
      allow update: if isOwner(userId) 
        || (isAuthenticated() && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'following', 'updatedAt']));
      
      // Only the user can delete their own profile
      allow delete: if isOwner(userId);
      
      // ============================================
      // USER SHELVES (want-to-read, reading, read)
      // ============================================
      
      match /shelves/{shelfId} {
        // Can view if profile is public OR user is following OR is owner
        allow read: if isPublicProfile(userId) || isFollowing(userId) || isOwner(userId);
        
        // Only owner can create/update/delete shelves
        allow write: if isOwner(userId);
        
        // BOOKS IN SHELVES
        match /books/{bookId} {
          // Can view if profile is public OR user is following OR is owner
          allow read: if isPublicProfile(userId) || isFollowing(userId) || isOwner(userId);
          
          // Only owner can add/move/remove books
          allow write: if isOwner(userId);
        }
      }
      
      // ============================================
      // USER READING GOALS
      // ============================================
      
      match /readingGoals/{goalId} {
        allow read: if isOwner(userId) || isPublicProfile(userId) || isFollowing(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // ============================================
    // USERNAME UNIQUENESS COLLECTION
    // ============================================
    
    match /usernames/{username} {
      // Anyone can check if username exists
      allow read: if true;
      
      // Users can claim their username
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Users can release their username
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // POSTS COLLECTION (Social Feed)
    // ============================================
    
    match /posts/{postId} {
      // Anyone can read posts (public social feed)
      allow read: if true;
      
      // Authenticated users can create posts with validation
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 5000
        && request.resource.data.tags is list
        && request.resource.data.likes is list;
      
      // Post author can update their post, or any user can update likes
      allow update: if isAuthenticated() 
        && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      
      // Only post author can delete their post
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // ============================================
      // COMMENTS SUBCOLLECTION
      // ============================================
      
      match /comments/{commentId} {
        // Anyone can read comments (public)
        allow read: if true;
        
        // Authenticated users can create comments
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        
        // Only comment author can update/delete their comment
        allow update, delete: if isAuthenticated() 
          && resource.data.userId == request.auth.uid;
      }
    }
    
    // ============================================
    // GLOBAL BOOKS CATALOG
    // ============================================
    
    match /books/{bookId} {
      // Anyone can read book information
      allow read: if true;
      
      // Authenticated users can add books (e.g., via barcode scan)
      allow create: if isAuthenticated()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.isbn is string;
      
      // Only original uploader can update book details
      allow update: if isAuthenticated() 
        && resource.data.addedBy == request.auth.uid;
    }
    
    // ============================================
    // REVIEWS COLLECTION
    // ============================================
    
    match /reviews/{reviewId} {
      // Anyone can read reviews (public social feature)
      allow read: if true;
      
      // Authenticated users can create reviews with validation
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0.5
        && request.resource.data.rating <= 5;
      
      // Review author can update their review, or any user can update likedBy/likesCount
      allow update: if isAuthenticated() 
        && (resource.data.userId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount']));
      
      // Only review author can delete their review
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // BOOK RATINGS AGGREGATION
    // ============================================
    
    match /bookRatings/{bookId} {
      // Anyone can read rating statistics (for display)
      allow read: if true;
      
      // Authenticated users can write (client-side aggregation for now)
      // TODO: Migrate to Cloud Functions for production
      allow write: if isAuthenticated();
    }
  }
}
